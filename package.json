{
  "name": "taskapp-professional",
  "version": "1.0.0",
  "private": true,
  "description": "Professional task completion platform",
  "homepage": "https://taskapp.vercel.app",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@reduxjs/toolkit": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "react-hook-form": "^7.48.2",
    "@tanstack/react-query": "^5.8.4",
    "react-hot-toast": "^2.4.1",
    "date-fns": "^2.30.0",
    "recharts": "^2.8.0",
    "clsx": "^2.0.0",
    "tailwindcss": "^3.3.6",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "framer-motion": "^10.16.16",
    "react-intersection-observer": "^9.5.3",
    "react-dropzone": "^14.2.3",
    "react-chartjs-2": "^5.2.0",
    "chart.js": "^4.4.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:prod": "REACT_APP_ENVIRONMENT=production react-scripts build",
    "seed-sample-data": "node scripts/seed-sample-data.js",
    "test": "react-scripts test --coverage --watchAll=false",
    "test:ci": "CI=true npm test",
    "eject": "react-scripts eject",
    "vercel-build": "npm run build:prod",
    "deploy": "npm run build:prod && npm run deploy:vercel",
    "deploy:vercel": "vercel --prod",
    "security-audit": "npm audit --audit-level moderate",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "analyze": "npm run build && npx serve -s build",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "echo 'Run the SQL from database/complete-schema.sql in your Supabase dashboard'",
    "db:seed": "node scripts/seed-database.js",
    "demo:create": "node scripts/create-demo-accounts.js",
    "health-check": "node scripts/health-check.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}