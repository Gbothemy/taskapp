# Supabase Configuration
# Copy this file to .env and replace with your actual Supabase project credentials

# Your Supabase project URL (found in your Supabase dashboard)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (found in your Supabase dashboard under Settings > API)
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Instructions:
# 1. Go to https://supabase.com and create a new project
# 2. Copy your project URL and anon key from the dashboard
# 3. Replace the values above with your actual credentials
# 4. Save this file as .env (without the .example extension)