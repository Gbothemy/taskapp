{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_SUPABASE_URL": "https://xwvpkvzotdaugkywdnme.supabase.co",
    "REACT_APP_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh3dnBrdnpvdGRhdWdreXdkbm1lIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQ1NjA2MDEsImV4cCI6MjA4MDEzNjYwMX0.GsdrOYy56nYs2UPAyPqfahzLJ3b37om3mABWV2SdXzs",
    "REACT_APP_VERSION": "1.0.0",
    "REACT_APP_ENVIRONMENT": "production",
    "REACT_APP_SUPPORT_EMAIL": "support@taskapp.com",
    "REACT_APP_COMPANY_NAME": "TaskApp Inc.",
    "REACT_APP_APP_NAME": "TaskApp Professional",
    "REACT_APP_APP_URL": "https://taskapp.vercel.app",
    "REACT_APP_ENABLE_PAYMENTS": "true",
    "REACT_APP_ENABLE_NOTIFICATIONS": "true",
    "REACT_APP_ENABLE_FILE_UPLOADS": "true",
    "REACT_APP_ENABLE_ANALYTICS": "true"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm ci",
  "framework": "create-react-app"
}